# ══════════════════════════════════════════════════════════════════════════════
# AI Study Hub — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── PostgreSQL Database ───────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_study_hub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use an App Password, NOT your main Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=AI Study Hub <your_gmail_address@gmail.com>

# ── AI Provider (Google Gemini) ───────────────────────────────────────────────
# Obtain your key at: https://makersuite.google.com/app/apikey
# Free tier available with generous quotas
# This key is loaded server-side only — it is NEVER sent to the browser.
GEMINI_API_KEY=your_gemini_api_key_here
